# ==============================================================
# Bifurcation Backend 环境变量模板
# 复制为 .env 并填写所有必填项后再启动
# 标注 [必填] 的项如果留空，服务将无法正常运行
# ==============================================================

# --------------------------------------------------------------
# 运行环境
# --------------------------------------------------------------
# dev  → 使用 SQLite，日志较详细
# prod → 使用 PostgreSQL，适合正式部署
APP_ENV=prod

# --------------------------------------------------------------
# 数据库  [必填 - 生产]
# --------------------------------------------------------------
# prod 环境读取 DATABASE_URL，dev 环境读取 DEV_DATABASE_URL
DATABASE_URL=postgresql+asyncpg://bifurcation:your-db-password@localhost:5432/bifurcation_db

# 仅 dev 环境使用
DEV_DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --------------------------------------------------------------
# 本站 JWT 会话  [必填]
# --------------------------------------------------------------
# 生成方法：python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-a-64-char-random-hex-string

ALGORITHM=HS256
# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --------------------------------------------------------------
# 服务绑定（可选，也可在 ecosystem.config.js / 启动命令中设置）
# --------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8057

# --------------------------------------------------------------
# CORS  [必填]
# 填写前端访问的域名，多个用逗号分隔，不要有尾部斜杠
# --------------------------------------------------------------
CORS_ORIGINS=https://bifurcation.secret-sealing.club

# --------------------------------------------------------------
# Casdoor SSO  [必填]
# --------------------------------------------------------------
CASDOOR_BASE_URL=https://your-casdoor-domain.com
CASDOOR_CLIENT_ID=your-casdoor-client-id
CASDOOR_CLIENT_SECRET=your-casdoor-client-secret
CASDOOR_ORGANIZATION_NAME=your-org-name
CASDOOR_APPLICATION_NAME=your-app-name

# 必须与 Casdoor Application 里配置的 Redirect URL 完全一致
# 指向前端回调页，不是后端地址
CASDOOR_REDIRECT_URI=https://bifurcation.secret-sealing.club/auth/callback

CASDOOR_SCOPE=openid profile email

# Casdoor OIDC 端点（留空则由 CASDOOR_BASE_URL 自动推导）
CASDOOR_AUTHORIZE_URL=
CASDOOR_TOKEN_URL=
CASDOOR_USERINFO_URL=
CASDOOR_JWKS_URL=

# OIDC Issuer：通常填 CASDOOR_BASE_URL 的值
CASDOOR_ISSUER=https://your-casdoor-domain.com
# OIDC Audience：通常填 CASDOOR_CLIENT_ID 的值
CASDOOR_AUDIENCE=your-casdoor-client-id

# --------------------------------------------------------------
# SSO 行为
# --------------------------------------------------------------
# state token 有效期（分钟）
SSO_STATE_EXPIRE_MINUTES=10
# 用 email 自动关联已有账号
SSO_AUTO_LINK_BY_EMAIL=true
# Casdoor token 中标识管理员角色的 claim 字段名（逗号分隔）
SSO_ADMIN_CLAIM_KEYS=roles,role
# 对应 claim 值中包含以下任意字符串，则同步为本站 admin
SSO_ADMIN_MATCH_VALUES=admin,administrator

# --------------------------------------------------------------
# SQL 调试（生产建议关闭）
# --------------------------------------------------------------
SQL_ECHO=false

# --------------------------------------------------------------
# 管理员初始化（可选）
# 留空 ADMIN_AUTH_SUBJECT 时，init_database.py 跳过预建管理员。
# 推荐做法：让带 admin claim 的 Casdoor 用户首次登录，自动同步为管理员。
# --------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_AUTH_PROVIDER=casdoor
ADMIN_AUTH_SUBJECT=
ADMIN_AUTH_USER_ID=
