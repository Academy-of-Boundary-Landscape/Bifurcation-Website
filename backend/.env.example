APP_ENV=dev

# Database
DEV_DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tree_story_db

# Local JWT/session
SECRET_KEY=change-this-to-a-long-random-secret
SQL_ECHO=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Backend CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Casdoor SSO
CASDOOR_BASE_URL=https://auth.secret-sealing.club
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORGANIZATION_NAME=
CASDOOR_APPLICATION_NAME=
CASDOOR_REDIRECT_URI=http://localhost:5173/auth/callback
CASDOOR_SCOPE=openid profile email
# Optional overrides. Leave empty unless your Casdoor deployment uses custom endpoints.
CASDOOR_AUTHORIZE_URL=
CASDOOR_TOKEN_URL=
CASDOOR_USERINFO_URL=
CASDOOR_JWKS_URL=
CASDOOR_ISSUER=https://auth.secret-sealing.club
CASDOOR_AUDIENCE=

# SSO behavior
SSO_STATE_EXPIRE_MINUTES=10
SSO_AUTO_LINK_BY_EMAIL=true
SSO_ADMIN_CLAIM_KEYS=roles,role
SSO_ADMIN_MATCH_VALUES=admin,administrator

# Optional prebound admin bootstrap for init_database.py.
# Recommended default: leave ADMIN_AUTH_SUBJECT empty and let Casdoor admin claims
# create/sync the local admin role on first SSO login.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_AUTH_PROVIDER=casdoor
ADMIN_AUTH_SUBJECT=
ADMIN_AUTH_USER_ID=
